---
import type { Translation, Locale } from '../i18n/index';
import Icon from '../components/Icon.astro';

interface Props {
  t: Translation;
  lang: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  /** Wider container, used by the home page hero. */
  wide?: boolean;
}

const { t, lang, title, description, canonicalPath, wide = false } = Astro.props;
const siteUrl = 'https://prolongedfasting.github.io';
const canonical = `${siteUrl}/${lang}${canonicalPath}`;

const navItems = [
  { path: '/', icon: 'info', label: t.nav.whyFast },
  { path: '/preparation/', icon: 'menu_book', label: t.nav.preparation },
  { path: '/what-to-consume/', icon: 'local_drink', label: t.nav.whatToConsume },
  { path: '/body-signals/', icon: 'monitor_heart', label: t.nav.bodySignals },
  { path: '/phases/', icon: 'timeline', label: t.nav.phases },
  { path: '/fast-break/', icon: 'dinner_dining', label: t.nav.fastBreak },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FFF8F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1E1C22" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" hreflang="en" href={`${siteUrl}/en${canonicalPath}`} />
    <link rel="alternate" hreflang="hu" href={`${siteUrl}/hu${canonicalPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${canonicalPath}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: t.siteName,
      url: siteUrl,
      inLanguage: lang,
      description,
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <style is:global>
      /* Same palette and roles as the Android app (ui/theme/Theme.kt). */
      :root {
        --peach: #F7CFB6;
        --salmon: #F4B7A5;
        --rose: #D99B9D;
        --mauve: #AD858E;
        --slate: #6B6875;

        --bg: #FFF8F4;
        --on-bg: #2E2B36;
        --on-bg-muted: #5E5A66;
        --primary: var(--slate);
        --on-primary: #FFFFFF;
        --primary-container: var(--peach);
        --on-primary-container: #2E2B36;
        --secondary: #8A6670;
        --secondary-container: var(--salmon);
        --on-secondary-container: #3B2226;
        --tertiary: #9A5E66;
        --tertiary-container: var(--rose);
        --on-tertiary-container: #3B1E22;
        --surface-low: #FCEFE9;
        --surface: #F9E8E1;
        --surface-high: #F5E1D9;
        --outline: #8E8893;
        --outline-variant: #E6D6D0;
        --error-container: #F9DEDC;
        --on-error-container: #410E0B;

        --ring-1: var(--salmon);
        --ring-2: var(--rose);
        --ring-3: var(--mauve);
        --ring-4: var(--slate);
        --ring-track: #EBDAD3;

        --radius-lg: 24px;
        --radius-md: 16px;
        --gap: 16px;
        --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1E1C22;
          --on-bg: #ECE4E6;
          --on-bg-muted: #CBC2C8;
          --primary: var(--peach);
          --on-primary: #3A2A22;
          --primary-container: var(--slate);
          --on-primary-container: #F7EDEA;
          --secondary: var(--salmon);
          --secondary-container: #6E4A52;
          --on-secondary-container: #FFE3DC;
          --tertiary: var(--rose);
          --tertiary-container: #5A3E45;
          --on-tertiary-container: #FFDDE0;
          --surface-low: #26242B;
          --surface: #2B2930;
          --surface-high: #35323A;
          --outline: #958D96;
          --outline-variant: #4A4550;
          --error-container: #8C1D18;
          --on-error-container: #F9DEDC;

          --ring-1: var(--peach);
          --ring-2: var(--salmon);
          --ring-3: var(--rose);
          --ring-4: var(--mauve);
          --ring-track: #35323A;
        }
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }

      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--on-bg);
        font-size: 17px;
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: inherit; }
      .icon { flex-shrink: 0; display: block; }
      :focus-visible { outline: 3px solid var(--secondary); outline-offset: 2px; border-radius: 6px; }

      .skip-link {
        position: absolute; left: 16px; top: -100px; z-index: 300;
        background: var(--primary); color: var(--on-primary);
        padding: 10px 16px; border-radius: 999px; font-weight: 600; text-decoration: none;
      }
      .skip-link:focus { top: 12px; }

      /* ── Header ─────────────────────────────────────────── */
      .site-header {
        position: sticky; top: 0; z-index: 200;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(1.4) blur(12px);
        -webkit-backdrop-filter: saturate(1.4) blur(12px);
        border-bottom: 1px solid var(--outline-variant);
      }
      .header-inner {
        max-width: 1180px; margin: 0 auto; padding: 0 16px;
        height: 64px; display: flex; align-items: center; gap: 8px;
      }
      .brand {
        display: flex; align-items: center; gap: 10px;
        font-weight: 650; font-size: 1.05rem; text-decoration: none; white-space: nowrap;
        margin-right: auto;
      }
      .brand svg { width: 28px; height: 28px; }

      .main-nav { display: none; }
      .main-nav a {
        display: flex; align-items: center; gap: 10px;
        text-decoration: none; color: var(--on-bg-muted);
        font-size: 0.95rem; font-weight: 500;
        padding: 10px 14px; border-radius: 999px;
      }
      .main-nav a:hover { color: var(--on-bg); background: var(--surface-low); }
      .main-nav a[aria-current='page'] { color: var(--on-secondary-container); background: var(--secondary-container); }

      .lang-switch {
        display: flex; padding: 3px; gap: 2px;
        background: var(--surface); border-radius: 999px;
      }
      .lang-switch a {
        font-size: 0.8rem; font-weight: 650; text-decoration: none;
        padding: 5px 11px; border-radius: 999px; color: var(--on-bg-muted);
      }
      .lang-switch a[aria-current='true'] { background: var(--primary); color: var(--on-primary); }

      .menu-button {
        display: grid; place-items: center;
        width: 44px; height: 44px; border-radius: 999px;
        border: none; background: none; color: var(--on-bg); cursor: pointer;
      }
      .menu-button:hover { background: var(--surface-low); }
      .menu-button .close { display: none; }
      .menu-button[aria-expanded='true'] .open { display: none; }
      .menu-button[aria-expanded='true'] .close { display: block; }

      /* Mobile: nav drops down as a panel */
      .main-nav.open {
        display: flex; flex-direction: column; gap: 2px;
        position: absolute; top: 64px; left: 0; right: 0;
        padding: 8px 12px 16px;
        background: var(--bg);
        border-bottom: 1px solid var(--outline-variant);
        box-shadow: 0 12px 24px -12px rgb(46 43 54 / 0.25);
      }
      .main-nav.open a { font-size: 1rem; padding: 12px 16px; }

      @media (min-width: 1180px) {
        .menu-button { display: none; }
        .main-nav { display: flex; gap: 2px; margin-right: 12px; }
        .main-nav a .icon { display: none; }
        .main-nav a { padding: 8px 12px; font-size: 0.9rem; }
      }

      /* ── Main ───────────────────────────────────────────── */
      main { flex: 1; width: 100%; max-width: 760px; margin: 0 auto; padding: 40px 16px 96px; }
      main.wide { max-width: 1080px; }

      h1 {
        font-size: clamp(1.9rem, 4.6vw, 2.6rem);
        line-height: 1.15; letter-spacing: -0.025em; font-weight: 700;
        margin-bottom: 12px;
      }
      h2 { font-size: 1.15rem; line-height: 1.3; font-weight: 650; letter-spacing: -0.01em; }
      h3 { font-size: 1rem; line-height: 1.35; font-weight: 650; }
      .lead { font-size: 1.1rem; color: var(--on-bg-muted); max-width: 62ch; }
      .page-head { margin-bottom: 32px; }

      /* ── Building blocks (mirror the app's components) ──── */
      .stack { display: flex; flex-direction: column; gap: var(--gap); }

      .card {
        background: var(--surface-low);
        border-radius: var(--radius-lg);
        padding: 24px;
      }
      .card-title { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
      .card p + p { margin-top: 10px; }
      .card.tonal { background: var(--secondary-container); color: var(--on-secondary-container); }

      .badge {
        display: grid; place-items: center; flex-shrink: 0;
        width: 40px; height: 40px; border-radius: 50%;
        background: var(--primary-container); color: var(--on-primary-container);
      }
      .badge.lg { width: 52px; height: 52px; }

      .muted { color: var(--on-bg-muted); }
      .card.tonal .muted { color: inherit; opacity: 0.85; }

      .items { display: flex; flex-direction: column; gap: 16px; }
      .item h3 { margin-bottom: 2px; }
      .item p { font-size: 0.97rem; }
      .items.ruled { gap: 0; }
      .items.ruled .item { padding: 14px 0; }
      .items.ruled .item + .item { border-top: 1px solid var(--outline-variant); }
      .items.ruled .item:first-child { padding-top: 0; }
      .items.ruled .item:last-child { padding-bottom: 0; }

      .notice {
        display: flex; gap: 14px; align-items: flex-start;
        border-radius: var(--radius-lg); padding: 20px 24px;
        background: var(--secondary-container); color: var(--on-secondary-container);
      }
      .notice .icon { margin-top: 3px; }
      .notice h2 { font-size: 1rem; margin-bottom: 4px; }
      .notice p { font-size: 0.97rem; }
      .notice.warning { background: var(--error-container); color: var(--on-error-container); }

      .button {
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        min-height: 52px; padding: 0 26px; border-radius: 999px;
        font-weight: 650; font-size: 1rem; text-decoration: none;
        background: var(--primary); color: var(--on-primary);
      }
      .button:hover { filter: brightness(1.08); }
      .button.text { background: none; color: var(--on-bg); padding: 0 18px; }
      .button.text:hover { background: var(--surface-low); filter: none; }

      /* ── Footer ─────────────────────────────────────────── */
      .site-footer { border-top: 1px solid var(--outline-variant); }
      .footer-inner {
        max-width: 1180px; margin: 0 auto; padding: 24px 16px;
        display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center;
        font-size: 0.9rem; color: var(--on-bg-muted);
      }
      .footer-inner a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; }
      .footer-inner a:hover { color: var(--on-bg); text-decoration: underline; }
      .footer-inner .copy { margin-left: auto; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">{t.ui.skip}</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`/${lang}/`}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="12" fill="none" stroke="var(--ring-track)" stroke-width="5" />
            <path d="M16 4 A12 12 0 1 1 5.6 22" fill="none" stroke="var(--ring-3)" stroke-width="5" />
          </svg>
          {t.siteName}
        </a>

        <nav class="main-nav" id="mainNav" aria-label={t.ui.menu}>
          {navItems.map((item) => (
            <a href={`/${lang}${item.path}`} aria-current={canonicalPath === item.path ? 'page' : undefined}>
              <Icon name={item.icon} size={20} />{item.label}
            </a>
          ))}
        </nav>

        <div class="lang-switch">
          <a href={`/en${canonicalPath}`} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <a href={`/hu${canonicalPath}`} hreflang="hu" lang="hu" aria-current={lang === 'hu' ? 'true' : undefined}>HU</a>
        </div>

        <button class="menu-button" id="menuToggle" aria-label={t.ui.menu} aria-expanded="false" aria-controls="mainNav">
          <span class="open"><Icon name="menu" size={24} /></span>
          <span class="close"><Icon name="close" size={24} /></span>
        </button>
      </div>
    </header>

    <main id="content" class={wide ? 'wide' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <a href={t.playStoreUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="android" size={18} />{t.downloadCta}
        </a>
        <a href={`/${lang}/privacy/`}>
          <Icon name="shield" size={18} />{t.privacy.title}
        </a>
        <span class="copy">&copy; {new Date().getFullYear()} {t.siteName}</span>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menuToggle');
      const nav = document.getElementById('mainNav');
      const setOpen = (open: boolean) => {
        nav?.classList.toggle('open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      };
      toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
      nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    </script>
  </body>
</html>
